# Neon : utiliser l'URL "Pooled connection" (host contenant -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Paiement ORZAYAH (clé avec permission DEPOSIT, jamais côté navigateur)
ORZAYAH_API_KEY=
# HOLD_MINUTES=15

# Photos des offres : Cloudinary (envoi direct du navigateur, preset NON signé ; jamais l API Secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=nexus_offers

# Alertes e-mail (facultatif) via Resend : domaine d envoi vérifié requis
RESEND_API_KEY=
MAIL_FROM="BackMarket <alertes@votre-domaine.com>"
